# Obsidian Agent Connector — optional environment overrides.
# Everything here is optional: `obsidian-agent init` writes ~/.obsidian-agent/config.json
# and that file is the source of truth. Env vars win over the config file.

# Where the config/activity log live (default: ~/.obsidian-agent)
# OBSIDIAN_AGENT_HOME=/home/user/.obsidian-agent

# Vault path override — handy for one-off runs or CI
# OBSIDIAN_VAULT_PATH=/home/user/Obsidian/MyVault

# Dashboard + MCP-over-HTTP port (default: 3100)
# PORT=3100

# License key from checkout. Unlocks the paid tier limits.
# OBSIDIAN_AGENT_LICENSE=oa_live_xxxxxxxxxxxx

# Stripe — only needed if YOU are the vendor running checkout from this dashboard.
# End users never need these.
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_PRICE_PERSONAL=price_xxx
# STRIPE_PRICE_TEAM=price_xxx
# STRIPE_TRIAL_DAYS=14
# PUBLIC_URL=http://localhost:3100
