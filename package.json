{
  "name": "vault-gate",
  "version": "1.0.0",
  "description": "Obsidian plugin: a local MCP server that opens your vault to AI assistants.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "test": "node scripts/build-tests.mjs && node --test test/*.test.mjs",
    "version": "node scripts/bump-version.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian-plugin",
    "mcp",
    "model-context-protocol",
    "ai",
    "claude"
  ],
  "author": "Riley G.",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.2.0",
    "builtin-modules": "^5.0.0",
    "esbuild": "^0.25.0",
    "obsidian": "^1.13.1",
    "typescript": "^5.9.3"
  }
}
